# VoiceIQ India — Environment Configuration Example
# Copy this file to .env and configure your values

# Application Metadata
PROJECT_NAME="VoiceIQ India"
VERSION="1.0.0"
DEBUG=false

# SQLite Database Persistence
DATABASE_URL="sqlite:///./voiceiq.db"

# Official Gnani AI Credentials (Vachana Platform)
# Replace with your API key from the Gnani developer portal
GNANI_API_KEY="your_actual_gnani_api_key_here"
GNANI_BASE_URL="https://api.vachana.ai"
GNANI_STT_ENDPOINT="/stt/v3"
GNANI_TTS_ENDPOINT="/api/v1/tts/inference"
GNANI_TIMEOUT_SECONDS=90.0

# Primary AI Provider Routing ('gemini', 'evon', or 'local')
AI_PROVIDER=gemini

# Google Gemini 3.8 Flash Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_TEMPERATURE=0.6

# Gnani Evon v3.3 Open-Weight Indic LLM (Hosted on Remote Linux GPU Server)
# Official Hugging Face: https://huggingface.co/gnani/gnani-evon-v3.3-30B-A3B
EVON_ENABLED=false
EVON_HF_REPO_ID=gnani/gnani-evon-v3.3-30B-A3B
EVON_BASE_URL=
EVON_API_KEY=
EVON_MODEL_NAME=evon
EVON_TIMEOUT_SECONDS=60
EVON_MAX_TOKENS=512
EVON_TEMPERATURE=0.6
EVON_TOP_P=0.95

# Server Binding
HOST="127.0.0.1"
PORT=8000
